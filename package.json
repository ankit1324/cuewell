{
  "name": "cuewell",
  "version": "1.0.3",
  "description": "AI interview copilot",
  "homepage": "https://cuewell.chaudharyankit.in/",
  "desktopName": "cuewell.desktop",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --disable-gpu",
    "test-speech": "node scripts/test-speech.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "electron-builder install-app-deps",
    "test": "node --test \"test/**/*.test.js\""
  },
  "author": {
    "name": "Ankit Chaudhary"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "dompurify": "^3.5.0",
    "dotenv": "^16.3.1",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^6.49.0",
    "prismjs": "^1.30.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "com.ankitchaudhary.cuewell",
    "productName": "Cuewell",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!website/**/*",
      "!*.md",
      "!.git/**/*",
      "!.github/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!bin/**/*",
      "!setup.sh",
      "!setup.ps1",
      "!tailwind.config.js",
      "!scripts/start.js",
      "!scripts/test-speech.js",
      "!scripts/*.nsh",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc",
      "!eng.traineddata",
      "!node_modules/**/*.map",
      "!node_modules/**/*.{ts,mts,cts}",
      "!node_modules/**/{README,CHANGELOG,HISTORY}*"
    ],
    "asarUnpack": [
      "assests/icons/**/*",
      "prompts/**/*",
      "scripts/whisper_worker.py"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true,
      "resetAdHocDarwinSignature": true
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assests/icons/app-icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cuewell uses the microphone to transcribe your speech locally with Whisper.",
        "NSCameraUsageDescription": "Cuewell does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "Cuewell captures the screen to read on-screen content for AI assistance."
      }
    },
    "win": {
      "icon": "assests/icons/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assests/icons/icon-512.png",
      "category": "Utility",
      "executableName": "cuewell",
      "maintainer": "Ankit Chaudhary",
      "vendor": "Ankit Chaudhary",
      "synopsis": "AI interview copilot",
      "description": "A desktop AI interview copilot for practice and mock interviews. Ask by screenshot, voice or typed chat, and read a structured answer as it streams in.",
      "desktop": {
        "entry": {
          "Name": "Cuewell",
          "GenericName": "AI interview copilot",
          "Keywords": "interview;practice;ai;copilot;",
          "Terminal": "false"
        }
      },
      "syncDesktopName": true
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "alsa-utils | sox"
      ],
      "recommends": [
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "priority": "optional",
      "artifactName": "Cuewell-${version}-linux-${arch}.${ext}",
      "packageCategory": "utils"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cuewell",
      "uninstallDisplayName": "Cuewell",
      "runAfterFinish": true,
      "installerIcon": "assests/icons/app-icon.ico",
      "uninstallerIcon": "assests/icons/app-icon.ico",
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Cuewell-${version}-win-${arch}-setup.${ext}"
    },
    "appImage": {
      "artifactName": "Cuewell-${version}-linux-${arch}.${ext}"
    },
    "dmg": {
      "title": "Cuewell",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    },
    "artifactName": "Cuewell-${version}-${os}-${arch}.${ext}",
    "portable": {
      "artifactName": "Cuewell-${version}-win-${arch}-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ankit1324/cuewell.git"
  },
  "bugs": {
    "url": "https://github.com/ankit1324/cuewell/issues"
  }
}
