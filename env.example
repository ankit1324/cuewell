# Cuewell settings. Settings and the onboarding wizard write this file for
# you; edit it by hand only for the advanced keys. Direct edits apply the next
# time Cuewell starts. Never commit a .env file with real keys.

# ── AI provider ──
# gemini | anthropic | openai | openrouter | groq | deepseek | ollama
LLM_PROVIDER=gemini
# Google Gemini key, from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Ollama runs on your machine and needs no key. A remote server must use https.
OLLAMA_MODEL=llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: GEMINI_MODEL overrides the default Gemini model, ANTHROPIC_EFFORT
# sets Claude's effort (low | medium | high | xhigh | max, default low), and
# <PROVIDER>_BASE_URL (e.g. OPENAI_BASE_URL, ANTHROPIC_BASE_URL) changes an endpoint.
# GEMINI_MODEL=
# ANTHROPIC_EFFORT=low
# OPENAI_BASE_URL=
# ANTHROPIC_BASE_URL=
# Streamed answers from the non-Gemini providers are aborted with a
# "request timeout" error once they send no data for this many milliseconds.
# The wait for the response headers keeps the 120 s request timeout.
LLM_STREAM_IDLE_TIMEOUT_MS=60000

# ── Answers ──
# Interview mode: auto | dsa (Coding) | technical | system-design | behavioral | hr
INTERVIEW_MODE=auto
# Answer length: auto | short | standard | detailed
# (auto is short for voice, standard for typed and screenshot questions)
ANSWER_LENGTH=auto
# Language for code answers in Auto and Coding modes: cpp | c | python | java | javascript
CODING_LANGUAGE=cpp

# ── Appearance ──
# Icon and name the app shows (Dock, menu bar tooltip, process title):
# terminal (Terminal) | activity (Activity Monitor) | settings (System Settings) | cuewell (Cuewell)
APP_ICON=terminal
# Space between the toolbar and the answer panel, in pixels (0 to 100)
WINDOW_GAP=10

# ── Updates ──
# Cuewell asks GitHub for the latest release at most once a day and never
# installs anything. Set to off to turn the automatic check off; Check for
# Updates… in the menus still works.
# UPDATE_CHECKS=off

# ── Speech ──
# whisper (local, private) or azure (Microsoft Azure Speech)
SPEECH_PROVIDER=whisper

# Azure Speech: a resource key and its region, e.g. eastus
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Local Whisper. Setup scripts and the onboarding wizard install it into
# .venv-whisper. By hand, for example:
#   pip install openai-whisper
# Use `whisper`, `python3 -m whisper`, or on Windows `.venv-whisper/Scripts/whisper.exe`
WHISPER_COMMAND=whisper
# Optional: the Python (with Whisper installed) that runs the faster Whisper
# worker. Leave empty to find it from the Whisper setup or WHISPER_COMMAND.
WHISPER_PYTHON=
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). A relative path is resolved against the folder
# that holds this .env file.
# WHISPER_MODEL_DIR=
# tiny | base | small | medium | large-v3 | turbo (bigger is slower and more accurate)
WHISPER_MODEL=small
# auto, or a language code such as en
WHISPER_LANGUAGE=auto
# auto | cpu | cuda
WHISPER_DEVICE=auto
# vad (stops at a pause) | manual (start and stop yourself)
WHISPER_CAPTURE_MODE=vad
# Where voice answers appear: both | chat | overlay
WHISPER_RESPONSE_TARGET=both
# Longest manual recording, in milliseconds
WHISPER_MANUAL_MAX_MS=90000
# Free the GPU after this many idle milliseconds
WHISPER_GPU_IDLE_MS=60000
# Audio chunk length when pause detection is off, in milliseconds (at least 2000)
WHISPER_SEGMENT_MS=4000
# Advanced pause detection tuning. Defaults shown; leave commented out.
# WHISPER_VAD_ENABLED=true
# WHISPER_SILENCE_HANGOVER_MS=700
# WHISPER_MIN_UTTERANCE_MS=350
# WHISPER_MAX_UTTERANCE_MS=15000
# WHISPER_PRE_ROLL_MS=300
# WHISPER_VAD_ENERGY_FLOOR=0.008

# ── Logs ──
# error | warn | info | debug (logs are in ~/.Cuewell/logs)
# LOG_LEVEL=info
